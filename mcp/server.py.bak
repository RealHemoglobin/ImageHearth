import sys
from pathlib import Path

from mcp.server.fastmcp import FastMCP

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))

from engine.kontext import generate as generate_kontext
from engine.workflow_runner import run_workflow
from engine.comfyui_manager import is_running, start
from engine.ollama_manager import get_loaded_models

mcp = FastMCP("ImageEngine")


@mcp.tool()
def generate_image(
    prompt: str,
    workflow: str = "sdxl_turbo",
    width: int = 1024,
    height: int = 1024,
    negative_prompt: str = "",
) -> str:
    """Generate an image from text using an available ImageEngine workflow."""
    filename = f"{workflow}.json"

    return run_workflow(
        workflow_name=filename,
        prompt=prompt,
        width=width,
        height=height,
        negative_prompt=negative_prompt,
    )


@mcp.tool()
def edit_image(image_path: str, prompt: str) -> str:
    """Edit an image using FLUX.1 Kontext."""
    return str(generate_kontext(prompt, image_path))


@mcp.tool()
def list_workflows() -> list:
    """List available ImageEngine workflows."""
    workflows_dir = ROOT / "workflows"

    return [
        {
            "name": path.stem,
            "file": path.name,
        }
        for path in sorted(workflows_dir.glob("*.json"))
    ]


@mcp.tool()
def get_engine_status() -> dict:
    """Return the status of ImageEngine, ComfyUI and Ollama."""
    import requests

    try:
        response = requests.get(
            "http://127.0.0.1:8188/system_stats",
            timeout=3,
        )
        response.raise_for_status()
        stats = response.json()
        comfy = True
        gpu = stats.get("devices", [])
    except requests.RequestException:
        comfy = False
        gpu = []

    try:
        ollama_models = get_loaded_models()
    except requests.RequestException:
        ollama_models = []

    return {
        "comfyui": "running" if comfy else "stopped",
        "ollama_models": ollama_models,
        "gpu_devices": gpu,
    }


@mcp.tool()
def ensure_comfyui() -> str:
    """Start ComfyUI if it is not already running."""
    start()
    return "ComfyUI is ready at http://127.0.0.1:8188"


if __name__ == "__main__":
    mcp.run(transport="stdio")
