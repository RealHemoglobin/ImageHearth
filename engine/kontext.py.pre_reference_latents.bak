import json
import time
import uuid
from pathlib import Path

import requests

from engine.orchestrator import generation_session

BASE_DIR = Path(__file__).resolve().parent.parent
WORKFLOW_FILE = BASE_DIR / "workflows" / "flux_kontext_dev_basic.json"
OUTPUT_DIR = BASE_DIR / "output"

API = "http://127.0.0.1:8188"
MAX_REFERENCE_IMAGES = 6


def upload_image(image_path):
    image_path = Path(image_path).expanduser().resolve()

    if not image_path.is_file():
        raise FileNotFoundError(image_path)

    with image_path.open("rb") as image:
        response = requests.post(
            f"{API}/upload/image",
            files={"image": (image_path.name, image)},
            data={"overwrite": "true"},
            timeout=120,
        )

    response.raise_for_status()
    return response.json()["name"]


def normalize_image_paths(image_path=None, image_paths=None):
    paths = []

    if image_path:
        paths.append(image_path)

    if image_paths:
        if isinstance(image_paths, (str, Path)):
            paths.append(image_paths)
        else:
            paths.extend(image_paths)

    # Eliminar duplicados conservando el orden.
    unique = []
    seen = set()

    for path in paths:
        resolved = str(Path(path).expanduser().resolve())
        if resolved not in seen:
            seen.add(resolved)
            unique.append(resolved)

    if not unique:
        raise ValueError("Debes proporcionar al menos una imagen de referencia.")

    if len(unique) > MAX_REFERENCE_IMAGES:
        raise ValueError(
            f"Kontext admite como máximo {MAX_REFERENCE_IMAGES} imágenes."
        )

    for path in unique:
        if not Path(path).is_file():
            raise FileNotFoundError(path)

    return unique


def prepare_reference_images(workflow, uploaded_images):
    if "190" not in workflow or "192:146" not in workflow:
        raise RuntimeError("El workflow Kontext no contiene los nodos esperados.")

    first_load = workflow["190"]
    first_stitch = workflow["192:146"]

    if first_load["class_type"] != "LoadImage":
        raise RuntimeError("El nodo 190 no es LoadImage.")

    if first_stitch["class_type"] != "ImageStitch":
        raise RuntimeError("El nodo 192:146 no es ImageStitch.")

    first_load["inputs"]["image"] = uploaded_images[0]

    if len(uploaded_images) == 1:
        return

    first_stitch["inputs"]["image1"] = ["190", 0]
    first_stitch["inputs"]["image2"] = [
        "IMAGEENGINE_LOAD_2",
        0,
    ]
    first_stitch["inputs"]["match_image_size"] = False

    workflow["IMAGEENGINE_LOAD_2"] = {
        "class_type": "LoadImage",
        "inputs": {"image": uploaded_images[1]},
    }

    previous_stitch = "192:146"

    for index, image_name in enumerate(uploaded_images[2:], start=3):
        load_id = f"IMAGEENGINE_LOAD_{index}"
        stitch_id = f"IMAGEENGINE_STITCH_{index}"

        workflow[load_id] = {
            "class_type": "LoadImage",
            "inputs": {"image": image_name},
        }

        workflow[stitch_id] = {
            "class_type": "ImageStitch",
            "inputs": {
                "image1": [previous_stitch, 0],
                "image2": [load_id, 0],
                "direction": "right",
                "match_image_size": False,
                "spacing_width": 0,
                "spacing_color": "white",
            },
        }

        previous_stitch = stitch_id

    workflow["192:42"]["inputs"]["image"] = [previous_stitch, 0]


def generate(
    prompt,
    image_path=None,
    timeout=900,
    image_paths=None,
):
    paths = normalize_image_paths(image_path, image_paths)

    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

    with generation_session():
        uploaded_images = [upload_image(path) for path in paths]

        workflow = json.loads(WORKFLOW_FILE.read_text())

        prepare_reference_images(workflow, uploaded_images)

        workflow["192:6"]["inputs"]["text"] = prompt

        filename = f"kontext_{uuid.uuid4().hex[:12]}"
        workflow["136"]["inputs"]["filename_prefix"] = filename

        response = requests.post(
            f"{API}/prompt",
            json={"prompt": workflow},
            timeout=60,
        )
        response.raise_for_status()

        prompt_id = response.json()["prompt_id"]
        print(f"Generación Kontext iniciada: {prompt_id}")
        print(f"Imágenes de referencia: {len(paths)}")

        deadline = time.time() + timeout

        while time.time() < deadline:
            history_response = requests.get(
                f"{API}/history/{prompt_id}",
                timeout=15,
            )
            history_response.raise_for_status()

            history = history_response.json().get(prompt_id)

            if history:
                status = history.get("status", {})

                if status.get("status_str") == "error":
                    raise RuntimeError(f"Error en ComfyUI: {status}")

                if status.get("completed"):
                    for node in history.get("outputs", {}).values():
                        for image in node.get("images", []):
                            if image.get("type") != "output":
                                continue

                            image_response = requests.get(
                                f"{API}/view",
                                params={
                                    "filename": image["filename"],
                                    "subfolder": image.get("subfolder", ""),
                                    "type": "output",
                                },
                                timeout=120,
                            )
                            image_response.raise_for_status()

                            destination = OUTPUT_DIR / f"{filename}.png"
                            destination.write_bytes(image_response.content)

                            print(f"Imagen guardada: {destination}")
                            return destination

            time.sleep(2)

        raise TimeoutError(f"ComfyUI no terminó en {timeout} segundos.")


if __name__ == "__main__":
    import argparse

    parser = argparse.ArgumentParser(description="Generación FLUX Kontext")
    parser.add_argument("image", nargs="+", help="Una o varias imágenes de referencia")
    parser.add_argument("--prompt", required=True, help="Instrucciones de edición")
    args = parser.parse_args()

    generate(args.prompt, image_paths=args.image)
